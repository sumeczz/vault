{
  "version": 1,
  "coordinateSpace": "world",
  "artDirection": {
    "workflow": "hybrid-ai-concept-manual-libreSprite-finalization",
    "style": "retro-arcade-comic-pixel-art",
    "editor": "LibreSprite",
    "visualRules": [
      "top-down silhouette readability",
      "bold ink outlines",
      "hard pixel shadows",
      "comic impact shapes and speed lines",
      "no sci-fi or fantasy weapon substitutions"
    ],
    "palette": {
      "ink": "#17151a",
      "warmPaper": "#e8d8b5",
      "bone": "#b9b09a",
      "brickRed": "#bd4938",
      "mustard": "#d5a642",
      "petrol": "#477c78",
      "plum": "#76516f"
    }
  },
  "integrationPolicy": {
    "gameplayAuthority": "simulation",
    "collisionFromArtwork": false,
    "proceduralFallbackRequired": true,
    "enableOnlyAfterQA": true
  },
